{
  "site": "learn.gaitherstephens.com",
  "$comment": "Unauthenticated only (PIN app). Zone host: gaitherstephens zone GETs proven fine from runners (stubbyz/fifthsense a11y baselines); no workers.dev subdomain enabled for this worker.",
  "journeys": [
    {
      "id": "login-renders",
      "steps": [
        {
          "goto": "https://learn.gaitherstephens.com/login"
        },
        {
          "wait_for": "form"
        },
        {
          "expect_min": {
            "selector": "input[type=password]",
            "count": 1
          }
        }
      ]
    },
    {
      "id": "root-redirects-to-login",
      "steps": [
        {
          "goto": "https://learn.gaitherstephens.com/"
        },
        {
          "wait_for": "form"
        },
        {
          "expect_not_text": "Internal Server Error"
        }
      ]
    }
  ]
}
